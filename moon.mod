// moon-wav: A MoonBit WAV audio decoding library
// https://github.com/bw448/moon-wav

name = "bw448/moon-wav"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/bw448/moon-wav"

license = "Apache-2.0"

keywords = [ "wav", "audio", "pcm", "decode", "RIFF" ]

preferred_target = "wasm"

description = "A native MoonBit WAV audio decoding library supporting PCM 8/16/24-bit, mono/stereo, format conversion and audio operations"
