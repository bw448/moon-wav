// moon-wav: A MoonBit WAV audio decoding library
// https://github.com/bw448/moon-wav

name = "bw448/moon-wav"

version = "0.2.0"

readme = "README.mbt.md"

repository = "https://github.com/bw448/moon-wav"

license = "Apache-2.0"

keywords = [ "wav", "audio", "pcm", "decode", "encode", "RIFF", "float" ]

preferred_target = "wasm"

description = "MoonBit 原生 WAV 音频解码库 | A native MoonBit WAV audio decoding library"
